# Discord Bot Token (https://discord.com/developers/applications 에서 발급)
DISCORD_TOKEN=your_bot_token_here

# 봇을 사용할 수 있는 Discord 유저 ID (본인만 사용하도록 제한)
# Discord에서 개발자 모드 켜고 → 본인 프로필 우클릭 → ID 복사
ALLOWED_USER_ID=your_user_id_here

# Claude Code가 작업할 기본 디렉토리 (선택사항)
WORKING_DIR=C:\SideProject\DiscordBot
