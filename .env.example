# Discord Bot Token (https://discord.com/developers/applications 에서 발급)
DISCORD_TOKEN=your_bot_token_here

# 봇을 사용할 수 있는 Discord 유저 ID (본인만 사용하도록 제한)
# Discord에서 개발자 모드 켜고 → 본인 프로필 우클릭 → ID 복사
ALLOWED_USER_ID=your_user_id_here

# Claude 카테고리 ID — 이 카테고리 내 모든 채널에서 일반 메시지를 Claude에 전달
# 카테고리 우클릭 → ID 복사 (개발자 모드 필요)
CLAUDE_CATEGORY_ID=your_category_id_here

# Claude Code가 작업할 기본 디렉토리 (선택사항, 기본값: 봇 실행 디렉토리)
# WORKING_DIR=C:\path\to\your\project

# Claude CLI 실행 파일 경로 (선택사항, 기본값: ~/.local/bin/claude.exe)
# CLAUDE_PATH=C:\path\to\claude.exe

# Claude effort 기본값 (선택사항: low/medium/high/xhigh/max, 채널별 /reasoning 선택이 우선)
# CLAUDE_EFFORT_LEVEL=high

# Codex 후속 메시지: 기본 app-server(현재 작업에 스티어링).
# 이전 exec + 대기열 방식으로 복귀하려면 exec로 설정 후 안전한 시점에 재시작.
# CODEX_TRANSPORT=app-server

# Unity 빌드용 환경변수 (선택사항 — Unity 안 쓰면 비워둬도 됨)
# ANDROID_HOME=C:\path\to\Android\SDK
# JAVA_HOME=C:\path\to\OpenJDK

# pythonw 실행 파일 경로 (선택사항 — PATH에 잡혀 있으면 안 써도 됨)
# run_forever.vbs, watchdog.bat 이 참조
# PYTHONW_PATH=C:\path\to\pythonw.exe
